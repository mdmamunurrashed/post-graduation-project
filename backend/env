# WebSentinel Backend — Environment Variables
# Copy this file to .env and fill in your OWN values.
# .env is gitignored — never commit real secrets.

# JWT signing secret — use a long random string
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Must match EXTENSION_API_KEY in extension/modules/config.js
EXTENSION_API_KEY=change-this-to-your-own-extension-key

# JWT token lifetime in hours
JWT_EXPIRE_HOURS=1

# HuggingFace API token — https://huggingface.co/settings/tokens
HF_API_TOKEN=your-huggingface-token-here
